<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plugins de Dataverse: la plataforma exige .NET Framework (4.6.2 a 4.8) y proyecto de estilo SDK.
       net462 es el que generan las herramientas de Microsoft (pac plugin init). Versiones fijadas: nada de comodines. -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <RootNamespace>Sanic.Mppp.Plugins</RootNamespace>
    <AssemblyName>Sanic.Mppp.Plugins</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- HAY QUE SUBIR EL TERCER NUMERO (el build) EN CADA DESPLIEGUE. Sin version explicita, cada compilacion sale
         1.0.0.0, Dataverse ve el mismo ensamblado de siempre y el sandbox sigue ejecutando el BINARIO VIEJO aunque el
         paquete se haya actualizado: los tipos nuevos aparecen en `plugintype` y al invocarlos responde "The plug-in
         type could not be found in the plug-in assembly" (verificado en Dev el 2026-09-22).
         Solo build o revision: cambiar major o minor hace que Dataverse lo trate como OTRO ensamblado y los steps ya
         registrados NO se re-apuntan solos (Learn, "Assembly versioning"). -->
    <AssemblyVersion>1.0.12.0</AssemblyVersion>
    <FileVersion>1.0.12.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Ya están en el sandbox de Dataverse: no se suben con el paquete. -->
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.60" PrivateAssets="All" />
    <!-- Permite compilar para .NET Framework sin Windows ni Visual Studio. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <!-- Lector de la plantilla Excel (7.2). Va como ensamblado dependiente dentro del paquete de plugins: corrió en el sandbox
         real en el spike C-05 parte B (6,5 MB sin comprimir). La versión es la que se probó ahí: no se sube sin volver a probar. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- En un proyecto de estilo SDK para .NET Framework no viene por defecto (spike C-05, local y sandbox). -->
    <Reference Include="System.IO.Compression" />
    <!-- DataContractJsonSerializer: los parámetros JSON se leen con lo que ya trae el framework.
         Microsoft advierte no depender de System.Text.Json en un plugin (la versión del sandbox puede ser otra). -->
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
</Project>
