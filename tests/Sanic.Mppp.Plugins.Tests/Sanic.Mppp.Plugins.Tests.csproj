<Project Sdk="Microsoft.NET.Sdk">
  <!-- Las pruebas corren en .NET moderno (Linux incluido) contra el ensamblado net462 y el SDK real de Dataverse.
       Sin FakeXrmEasy: los dobles son propios (OrganizationServiceEnMemoria, inventario 7.5). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <!-- NU1701/NU1702: referencia a net462 desde .NET moderno, a propósito.
         NU1903: System.Security.Cryptography.Pkcs 6.0.1 llega transitivo por el SDK de Dataverse; solo vive en el proyecto de pruebas, no se despliega. -->
    <NoWarn>NU1701;NU1702;NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.60" />
    <ProjectReference Include="../../src/Sanic.Mppp.Plugins/Sanic.Mppp.Plugins.csproj" />
  </ItemGroup>
</Project>
